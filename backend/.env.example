# ── Data ──────────────────────────────────────
# DATA_DIR=data

# ── Logging ───────────────────────────────────
# Global fallback. Each subsystem falls back to this if not set separately.
# Levels: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
# MOLLY_LOG_LEVEL=INFO
# MOLLY_LOG_LEVEL_BACKEND=DEBUG
# MOLLY_LOG_LEVEL_UVICORN=INFO
# MOLLY_LOG_LEVEL_RTC=WARNING

# ── Processor ─────────────────────────────────
# Max screenshots fed to Gemini per processing run (older ones are skipped)
# MOLLY_MAX_ARTEFACTS=20
# Minimum confidence (1-10) to index an item into the vector store
# MOLLY_CONFIDENCE_THRESHOLD=5
# Vector similarity threshold (0-1) to treat two items as the same proposition
# MOLLY_MERGE_THRESHOLD=0.5
# Minimum similarity score (0-1) to include a user trait in proactive tip context
# MOLLY_TRAIT_SIMILARITY_THRESHOLD=0.5

# ── API Keys (also configurable in-app via Settings) ──
# GEMINI_API_KEY=AIza...
# CARTESIA_API_KEY=sk-...
# SONIOX_API_KEY=soniox-...

# ── Authentication ────────────────────────────
# JWT_SECRET=change-me
# FERNET_KEY=change-me-too

# ── CORS ──────────────────────────────────────
# CORS_ORIGINS=*

# ── WebRTC ────────────────────────────────────
# TURN_SERVER=turn:example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# ── Email ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
